<Window x:Class="SyncMLViewer.WnsOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WNS Options" SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WNS Providers -->
        <TextBlock Grid.Row="0" Text="WNS Providers" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Margin="10,0,0,15">
            <CheckBox x:Name="CheckBoxPlatform" Content="PushNotifications-Platform" Margin="0,3"/>
            <CheckBox x:Name="CheckBoxDeveloper" Content="PushNotifications-Developer" Margin="0,3"/>
            <CheckBox x:Name="CheckBoxInProc" Content="PushNotifications-InProc" Margin="0,3"/>
            <CheckBox x:Name="CheckBoxPushRouter" Content="DeviceManagement-Pushrouter" Margin="0,3"/>
        </StackPanel>

        <!-- ETW Parser Options -->
        <TextBlock Grid.Row="2" Text="ETW Parser Registration" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Margin="10,0,0,0">
            <CheckBox x:Name="CheckBoxDynamicAll" Content="Register Dynamic.All parser" Margin="0,3"
                      ToolTip="Captures events with manifest embedded in the event stream"/>
            <CheckBox x:Name="CheckBoxUnhandledEvents" Content="Register UnhandledEvents parser" Margin="0,3"
                      ToolTip="Captures MOF, WPP, and classic provider events"/>
            <TextBlock Text="Parser changes take effect after restart." FontSize="10" Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="75" Height="26" IsDefault="True" Click="ButtonOk_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="75" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
